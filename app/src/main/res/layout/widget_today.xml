<?xml version="1.0" encoding="utf-8"?>
<!-- Today widget. Every size (widget_today*.xml) uses the same view ids; TodayWidget picks one per size. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="🦆 Today"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/w_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 0"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:text="Easy run"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp" android:textStyle="bold"
        android:layout_marginTop="8dp" />
    <TextView
        android:id="@+id/w_big"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:text="4 mi"
        android:textColor="#FFFFFFFF"
        android:textSize="34sp" android:textStyle="bold"
        android:layout_marginTop="2dp" />
    <TextView
        android:id="@+id/w_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:text="11:45–13:00 /mi · effort 3–4"
        android:textColor="#E6FFFFFF"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />
    <TextView
        android:id="@+id/w_strength"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:text="🏋️ + Strength"
        android:textColor="#E6FFFFFF"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <TextView
        android:id="@+id/w_todo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:text="To do: 🏃 🧘"
        android:textColor="#FFFEE123"
        android:textSize="13sp" android:textStyle="bold" />
    <TextView
        android:id="@+id/w_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:text="170 days to Eugene"
        android:textColor="#B3FFFFFF"
        android:textSize="11sp"
        android:layout_marginTop="4dp" />
</LinearLayout>
